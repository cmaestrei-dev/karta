{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaFuncionDeKarta",
      "Effect": "Allow",
      "Action": [
        "lambda:Get*", "lambda:List*", "lambda:CreateFunction", "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration", "lambda:PublishVersion", "lambda:InvokeFunction",
        "lambda:CreateFunctionUrlConfig", "lambda:UpdateFunctionUrlConfig", "lambda:AddPermission",
        "lambda:RemovePermission", "lambda:PutFunctionConcurrency", "lambda:DeleteFunctionConcurrency",
        "lambda:TagResource"
      ],
      "Resource": "arn:aws:lambda:us-east-1:CUENTA:function:karta-api*"
    },
    {
      "Sid": "SusRegistros",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup", "logs:PutRetentionPolicy", "logs:DescribeLogStreams", "logs:GetLogEvents",
        "logs:FilterLogEvents", "logs:StartLiveTail", "logs:StopLiveTail"
      ],
      "Resource": "arn:aws:logs:us-east-1:CUENTA:log-group:/aws/lambda/karta-api*"
    },
    {
      "Sid": "ElCalentador",
      "Effect": "Allow",
      "Action": ["scheduler:GetSchedule", "scheduler:CreateSchedule", "scheduler:UpdateSchedule"],
      "Resource": "arn:aws:scheduler:us-east-1:CUENTA:schedule/default/karta-api-*"
    },
    {
      "Sid": "VerSusRoles",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:ListAttachedRolePolicies", "iam:ListRolePolicies", "iam:GetRolePolicy"],
      "Resource": "arn:aws:iam::CUENTA:role/karta-api-*"
    },
    {
      "Sid": "UsarElRolDeLaFuncion",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::CUENTA:role/karta-api-lambda",
      "Condition": {"StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}}
    },
    {
      "Sid": "UsarElRolDelCalentador",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::CUENTA:role/karta-api-calentador",
      "Condition": {"StringEquals": {"iam:PassedToService": "scheduler.amazonaws.com"}}
    },
    {
      "Sid": "SoloLectura",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions", "lambda:GetAccountSettings", "logs:DescribeLogGroups", "scheduler:ListSchedules",
        "cloudwatch:GetMetricData", "cloudwatch:GetMetricStatistics", "cloudwatch:ListMetrics",
        "freetier:GetFreeTierUsage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SusPropiasLlaves",
      "Effect": "Allow",
      "Action": ["iam:GetUser", "iam:ListAccessKeys"],
      "Resource": "arn:aws:iam::CUENTA:user/camilo-dev"
    }
  ]
}
