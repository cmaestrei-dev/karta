{
 "version": 8,
 "name": "Karta Bahía (oscuro)",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet",
   "attribution": "© OpenFreeMap © colaboradores de OpenStreetMap"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "fondo",
   "type": "background",
   "paint": {
    "background-color": "#101C28"
   }
  },
  {
   "id": "parques",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "park",
   "paint": {
    "fill-color": "#10231F",
    "fill-opacity": 0.8
   }
  },
  {
   "id": "verde",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "grass",
     "wood"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#10231F",
    "fill-opacity": 0.6
   }
  },
  {
   "id": "agua",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "filter": [
    "!",
    [
     "match",
     [
      "get",
      "brunnel"
     ],
     [
      "tunnel"
     ],
     true,
     false
    ]
   ],
   "paint": {
    "fill-color": "#0A2436"
   }
  },
  {
   "id": "canales",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "waterway",
   "paint": {
    "line-color": "#0A2436",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     12,
     0.5,
     18,
     4
    ]
   }
  },
  {
   "id": "edificios",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "building",
   "minzoom": 15,
   "paint": {
    "fill-color": "#15283A",
    "fill-opacity": 0.7
   }
  },
  {
   "id": "calles",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 13,
   "filter": [
    "all",
    [
     "match",
     [
      "get",
      "class"
     ],
     [
      "minor",
      "service",
      "track"
     ],
     true,
     false
    ],
    [
     "!",
     [
      "match",
      [
       "get",
       "brunnel"
      ],
      [
       "tunnel"
      ],
      true,
      false
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#172A3C",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     13,
     0.5,
     18,
     7
    ]
   }
  },
  {
   "id": "vias",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 11,
   "filter": [
