    [
     "match",
     [
      "get",
      "class"
     ],
     [
      "secondary",
      "tertiary"
     ],
     true,
     false
    ],
    [
     "!",
     [
      "match",
      [
       "get",
       "brunnel"
      ],
      [
       "tunnel"
      ],
      true,
      false
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
