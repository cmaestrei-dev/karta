   "paint": {
    "line-color": "#1F3346",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     11,
     0.8,
     18,
     11
    ]
   }
  },
  {
   "id": "principales",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 9,
   "filter": [
    "all",
    [
     "match",
     [
      "get",
      "class"
     ],
     [
      "primary",
      "trunk",
      "motorway"
     ],
     true,
     false
    ],
    [
     "!",
     [
      "match",
      [
       "get",
       "brunnel"
      ],
      [
       "tunnel"
      ],
      true,
      false
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#2A4560",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     9,
     1,
     18,
     14
    ]
   }
  },
  {
   "id": "nombres-de-vias",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "transportation_name",
   "minzoom": 14,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "primary",
     "secondary",
     "tertiary",
     "trunk"
    ],
    true,
    false
   ],
   "layout": {
    "symbol-placement": "line",
    "text-field": [
     "get",
     "name"
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     14,
     10,
     18,
     13
    ]
   },
   "paint": {
    "text-color": "#7F96AA",
    "text-halo-color": "#0B1621",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "nombres-de-agua",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "water_name",
   "layout": {
    "text-field": [
     "get",
     "name"
    ],
    "text-font": [
     "Noto Sans Italic"
    ],
    "text-size": 12
   },
   "paint": {
    "text-color": "#4F7C99",
    "text-halo-color": "#0B1621",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "barrios",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "minzoom": 12,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "suburb",
     "neighbourhood",
     "quarter"
    ],
    true,
    false
   ],
   "layout": {
    "text-field": [
     "get",
     "name"
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     12,
     10,
     16,
     13
    ],
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#9DB2C4",
    "text-halo-color": "#0B1621",
    "text-halo-width": 1.5
   }
  }
 ]
}
