# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.

# MongoDB. Con docker compose el host es "mongo"; desde tu equipo, "localhost".
# En MongoDB Atlas se usa la cadena mongodb+srv://... que entrega el panel.
MONGO_URI=mongodb://karta:karta@localhost:27017/?authSource=admin
MONGO_DB=karta

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres). Genera uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=reemplazame-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRE_MINUTES=10080

# Orígenes permitidos por CORS, separados por coma. "*" solo para desarrollo.
CORS_ORIGINS=*

# Usuario de demostración que crea `python -m src.infrastructure.seed` (solo desarrollo).
DEMO_EMAIL=demo@karta.app
DEMO_PASSWORD=KartaDemo2026
