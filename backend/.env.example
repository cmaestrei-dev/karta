# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.

# Base de datos PostgreSQL con la extensión PostGIS habilitada.
# Con docker compose el host es "db"; en una instalación local, "localhost".
DATABASE_URL=postgresql://karta:karta@localhost:5432/karta_db

# Orígenes permitidos por CORS, separados por coma. "*" solo para desarrollo.
CORS_ORIGINS=*
